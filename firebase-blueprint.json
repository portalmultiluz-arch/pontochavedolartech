          }
        },
        "notes": { "type": "string" }
      },
      "required": ["timestamp", "usdCommercial", "eurRate", "gbpRate", "selicRate"]
    },
    "Order": {
      "title": "Order",
      "description": "E-commerce customer orders with items, delivery info and payment details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "customerInfo": { "type": "object" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shipping": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "paymentDetails": { "type": "object" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["orderId", "total", "customerInfo", "items"]
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Inventory movement audit log (sales, entries, damage, returns)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "type": { "type": "string" },
        "quantity": { "type": "number" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "orderId": { "type": "string" },
        "reason": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["productId", "type", "quantity"]
    },
    "ConsultancyRequest": {
      "title": "ConsultancyRequest",
      "description": "Technical engineering and lighting design AI consultancies",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "projectType": { "type": "string" },
        "environmentArea": { "type": "string" },
        "aiReport": { "type": "string" },
        "orderId": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "StoreModulesConfig": {
      "title": "StoreModulesConfig",
      "description": "Configuration of active modules in the storefront",
      "type": "object",
      "properties": {
        "showDailyOffer": { "type": "boolean" },
        "showTechnicalBanner": { "type": "boolean" },
        "showPartnerMarketplace": { "type": "boolean" }
      }
    },
    "PartnerMarketplaceSettings": {
      "title": "PartnerMarketplaceSettings",
      "description": "Configuration and terms for partner service providers marketplace",
      "type": "object",
      "properties": {
        "marketplaceTitle": { "type": "string" },
        "marketplaceSubtitle": { "type": "string" },
        "termsVersion": { "type": "string" },
        "termsText": { "type": "string" }
      }
    },
    "TestConnection": {
      "title": "TestConnection",
      "description": "Firestore health check document",
      "type": "object",
      "properties": {
        "status": { "type": "string" }
      }
    }
  },
  "firestore": {
    "test": { "schema": "TestConnection", "description": "Connection health check" },
    "customers": { "schema": "Customer", "description": "Customer records" },
    "suppliers": { "schema": "Supplier", "description": "Supplier records" },
    "products": { "schema": "Product", "description": "Inventory and marketplace items" },
    "services": { "schema": "Service", "description": "Services catalog" },
    "orders": { "schema": "Order", "description": "E-commerce orders" },
    "stock_movements": { "schema": "StockMovement", "description": "Inventory movement audit log" },
    "consultancy_requests": { "schema": "ConsultancyRequest", "description": "AI consultancy requests" },
    "store_modules_config": { "schema": "StoreModulesConfig", "description": "Storefront modules activation config" },
    "partner_marketplace_settings": { "schema": "PartnerMarketplaceSettings", "description": "Partner marketplace settings" },
    "partner_providers": { "schema": "PartnerProvider", "description": "Autonomous certified service providers directory" },
    "sales": { "schema": "Sale", "description": "Sales history" },
    "finance": { "schema": "FinancialTransaction", "description": "Financial ledger" },
    "daily_financial_kpis": { "schema": "DailyFinancialKPI", "description": "Daily managerial financial indicators ledger" },
    "market_economic_indicators": { "schema": "MarketEconomicIndicators", "description": "National and international market exchange rates, interest rates, and macro indicators" },
    "siteSettings": { "schema": "SiteSettings", "description": "General site configuration" },
    "collaborators": { "schema": "Collaborator", "description": "Collaborators and RBAC settings" },
    "media_assets": { "schema": "MediaAsset", "description": "Media bank assets and images" },
    "hero_covers": { "schema": "HeroCoverAsset", "description": "Hero cover templates and promotional banners banco" },
    "rma_records": { "schema": "RMARecord", "description": "Return and warranty management records" },
    "audit_logs": { "schema": "AuditLogRecord", "description": "System access and operation audit trail" },
    "site_marketing_security": { "schema": "MarketingSecurityConfig", "description": "Marketing, SEO and tracking pixels config" },
    "dailyOffers": { "schema": "Product", "description": "Daily highlighted offers" },
    "promos": { "schema": "Product", "description": "Promotional banners and campaigns" },
    "technicalConsultancies": { "schema": "SiteSettings", "description": "Technical reports and AI consultancies" },
    "technicalConsultancyProjects": { "schema": "SiteSettings", "description": "Client consultancy projects" },
    "quotes": { "schema": "Sale", "description": "Budget and quote proposals" }
